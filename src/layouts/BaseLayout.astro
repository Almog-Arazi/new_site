---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/reset.css';
import '../styles/base.css';
import '../styles/typography.css';
import '../styles/utilities.css';
import '../styles/print.css';

import site, { hasAnalytics } from '../site.config';
import Seo from '../components/seo/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import IconSprite from '../components/ui/IconSprite.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import MobileCtaBar from '../components/chrome/MobileCtaBar.astro';
import DesktopCtaDock from '../components/chrome/DesktopCtaDock.astro';
import AccessibilityMenu from '../components/chrome/AccessibilityMenu.astro';
import { localBusiness, organization, website } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  /** Extra JSON-LD entities for this page. */
  schemas?: unknown[];
  /** The homepage emits the business entity; inner pages only reference it. */
  withBusiness?: boolean;
  showRail?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  ogType,
  noindex = false,
  publishedTime,
  modifiedTime,
  schemas = [],
  withBusiness = false,
  showRail = true,
} = Astro.props;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14224A" />
    <meta name="format-detection" content="telephone=no" />

    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Only the Hebrew subsets are preloaded — Latin arrives via unicode-range
        without competing with LCP. */}
    <link
      rel="preload"
      href="/fonts/heebo-hebrew-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/assistant-hebrew-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <JsonLd data={website()} />
    <JsonLd data={organization()} />
    {withBusiness && <JsonLd data={localBusiness()} />}
    {schemas.map((schema) => <JsonLd data={schema} />)}

    {
      hasAnalytics && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}
          />
          <script is:inline define:vars={{ id: site.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', id);
          </script>
        </>
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">דילוג לתוכן הראשי</a>
    <IconSprite />
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    {showRail && <DesktopCtaDock />}
    <MobileCtaBar />
    <AccessibilityMenu />

    <script>
      import '../scripts/analytics';
      import '../scripts/nav';
      import '../scripts/cta-dock';
    </script>
  </body>
</html>
