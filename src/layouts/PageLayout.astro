---
import BaseLayout from './BaseLayout.astro';
import PageHead from '../components/blocks/PageHead.astro';
import CtaBand from '../components/blocks/CtaBand.astro';
import { BLOCKS } from '../components/blocks/registry';
import { breadcrumb as breadcrumbSchema } from '../lib/schema';
import type { Section } from '../content.config';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  eyebrow?: string;
  h1: string;
  lead: string;
  breadcrumb?: { label: string; href: string }[];
  breadcrumbLabel: string;
  hero?: { placeholder: Parameters<typeof PageHead>[0]['hero'] } | undefined;
  sections?: Section[];
  schemas?: unknown[];
  cta?: { heading: string; text?: string };
}

const {
  title,
  description,
  path,
  noindex = false,
  eyebrow,
  h1,
  lead,
  breadcrumb = [],
  breadcrumbLabel,
  sections = [],
  schemas = [],
  cta,
} = Astro.props;

const hero = (Astro.props as Record<string, unknown>).hero as
  | { placeholder: string; alt: string; note?: string }
  | undefined;

const trail = [{ label: 'ראשי', href: '/' }, ...breadcrumb];
const allSchemas = [...schemas, breadcrumbSchema([...trail, { label: breadcrumbLabel, href: path }])];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={noindex}
  schemas={allSchemas}
>
  <PageHead
    eyebrow={eyebrow}
    h1={h1}
    lead={lead}
    breadcrumb={trail}
    breadcrumbLabel={breadcrumbLabel}
    hero={hero as never}
  />

  {
    sections.map((section) => {
      const Block = BLOCKS[section.type] as never;
      return <Block {...(section as never)} />;
    })
  }

  <slot />

  {
    cta && (
      <CtaBand
        type="ctaBand"
        heading={cta.heading}
        text={cta.text}
        tone="dark"
        primary={{ label: 'תיאום בדיקה', href: '/contact' }}
      />
    )
  }
</BaseLayout>
