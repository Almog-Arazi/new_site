---
import { getCollection, render } from 'astro:content';
import { pathForSlug } from '../lib/routes';

import ServicePage from '../components/templates/ServicePage.astro';
import EquipmentPage from '../components/templates/EquipmentPage.astro';
import HubPage from '../components/templates/HubPage.astro';
import FaqPage from '../components/templates/FaqPage.astro';
import AboutPage from '../components/templates/AboutPage.astro';
import LegalPage from '../components/templates/LegalPage.astro';
import RegionPage from '../components/templates/RegionPage.astro';

/* ============================================================
   Generates 15 of the 18 routes. A new page — including a future regional
   page — is created by adding one entry to the `pages` collection from the
   CMS. No developer, no new route file.

   This file does exactly two things: resolve the entry, and hand it to the
   template its `template` field names. Every composition decision and every
   JSON-LD entity lives in the template, so a page type can change shape
   without touching routing.
   ============================================================ */

const TEMPLATES = {
  service: ServicePage,
  equipment: EquipmentPage,
  hub: HubPage,
  faq: FaqPage,
  about: AboutPage,
  legal: LegalPage,
  region: RegionPage,
} as const;

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((page) => ({ params: { slug: page.data.slug }, props: { page } }));
}

const { page } = Astro.props;
const data = page.data;
const path = pathForSlug(data.slug);

/* `template` is a closed enum in the frozen schema, so this cannot miss —
   but a page that somehow arrives without one still renders as a service
   page rather than throwing during a client's CMS save. */
const Template = TEMPLATES[data.template] ?? ServicePage;

const { Content } = await render(page);
const hasBody = Boolean(page.body?.trim());
---

<Template page={page} path={path} hasBody={hasBody}>
  <Content />
</Template>
