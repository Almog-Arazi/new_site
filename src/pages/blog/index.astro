---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import { blog, itemList } from '../../lib/schema';
import { articlePath } from '../../lib/routes';
import site from '../../site.config';

/* PHASE 0 STUB — ownership passes to Stream C. */
const path = '/blog';
const description =
  'מאמרים מקצועיים על בדיקות מתקני הרמה, בדיקת מלגזה, אביזרי הרמה וקווי חיים — מידע למנהלי אחזקה וממוני בטיחות.';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title={`מידע מקצועי בתחום בדיקות ציוד הרמה | ${site.shortName}`}
  description={description}
  path={path}
  schemas={[
    blog({ name: 'מידע מקצועי בתחום בדיקות ציוד הרמה', description, path }),
    itemList(articles.map((a) => ({ name: a.data.title, url: articlePath(a.data.slug) }))),
  ]}
>
  <Section>
    <h1>מידע מקצועי בתחום בדיקות ציוד הרמה</h1>
    <p class="t-lead">{description}</p>
    <div class="grid grid--3" style="margin-block-start:var(--s-8)">
      {articles.map((a) => (
        <Card href={articlePath(a.data.slug)}>
          <p class="t-eyebrow">{a.data.category}</p>
          <h2 class="t-h3">{a.data.title}</h2>
          <p class="t-body">{a.data.description}</p>
        </Card>
      ))}
    </div>
  </Section>
</BaseLayout>
