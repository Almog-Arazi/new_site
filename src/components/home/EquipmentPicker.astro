---
import { getCollection } from 'astro:content';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Chip from '../ui/Chip.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { telHrefFor } from '../../lib/format';

/* Chip multi-select. src/scripts/chips.ts reads this markup and dispatches
   the frozen cross-stream contract:
     document → CustomEvent('equipment:change', { detail: { ids } })
   Stream A's lead form listens and preselects its equipment field.
   The markup hooks are the contract: [data-equipment-picker], [data-chip]
   (supplied by Chip as="toggle"), [data-picker-label][data-empty]. */

interface Props {
  heading?: string;
  intro?: string;
  emptyLabel?: string;
  formHref?: string;
}

const {
  heading = 'איזה ציוד צריך בדיקה?',
  intro = 'בחרו את סוגי הציוד ואנחנו נחזור אליכם עם הצעה מדויקת.',
  emptyLabel = 'בחרו סוג ציוד אחד או יותר. הבחירה תיטען אוטומטית לטופס.',
  formHref = '#lead',
} = Astro.props;

const items = (await getCollection('equipment')).sort((a, b) => a.data.order - b.data.order);
---

<Section tone="soft" id="equipment-picker">
  <SectionHeader heading={heading} intro={intro} />

  <div class="picker" data-equipment-picker>
    <div class="picker__chips">
      {items.map((item) => <Chip as="toggle" value={item.data.id}>{item.data.label}</Chip>)}
    </div>

    <div class="picker__result">
      <p class="picker__label" data-picker-label data-empty={emptyLabel} aria-live="polite">
        {emptyLabel}
      </p>
      <div class="cluster picker__actions">
        <Button href={telHrefFor()} variant="ghost" size="lg" track="phone_click">
          <Icon name="phone" size={20} />
          דברו איתנו עכשיו
        </Button>
        <Button href={formHref} variant="primary" size="lg">שליחת בקשה</Button>
      </div>
    </div>
  </div>
</Section>

<style>
  .picker {
    display: grid;
    gap: var(--s-6);
  }

  .picker__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  /* One quiet panel holding the live answer and the two next steps. */
  .picker__result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding: var(--card-pad);
    background: var(--c-surface);
    border: var(--hairline);
    border-radius: var(--r-4);
  }

  .picker__label {
    flex: 1 1 18rem;
    min-inline-size: 0;
    font-family: var(--ff-head);
    font-size: var(--fs-lead);
    font-weight: var(--fw-med);
    line-height: var(--lh-h3);
    color: var(--c-heading);
  }

  .picker__actions {
    flex: 0 1 auto;
  }
</style>
