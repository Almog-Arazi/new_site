---
import LeadForm from '../form/LeadForm.astro';
import PhotoFrame from '../media/PhotoFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import TelLink from '../ui/TelLink.astro';
import type { PlaceholderVariant } from '../placeholders/index';

/* Homepage hero (sketch P1). This is the one page whose <h1> does not come
   from PageHead — the homepage has no breadcrumb and pairs the heading with
   a lead-capture panel, so it uses a bespoke head, exactly as the frozen
   ArticleLayout does. Still exactly one <h1> in the document. */

interface Props {
  h1: string;
  lead: string;
  trust: string[];
  media: { placeholder: PlaceholderVariant; alt: string; note?: string; image?: string };
  formEyebrow?: string;
  formHeading?: string;
  formIntro?: string;
}

const {
  h1,
  lead,
  trust,
  media,
  formEyebrow = 'תיאום בדיקה · 30 שניות',
  formHeading = 'נחזור אליכם עם זמינות ומחיר',
  formIntro = 'חמישה שדות בלבד. נחזור אליכם עם זמינות ומחיר לבדיקה.',
} = Astro.props;

/* LeadForm brings its own navy panel — the hero places it, it does not
   wrap it. */
---

<section class="hero">
  <div class="section__slab hero__slab">
    <div class="container hero__grid">
      <div class="hero__main">
        <h1 class="hero__title">{h1}</h1>
        <p class="t-lead hero__lead">{lead}</p>

        <PhotoFrame
          variant={media.placeholder}
          alt={media.alt}
          note={media.note}
          image={media.image}
          ratio="wide"
          eager
          class="hero__media"
        />

        <ul role="list" class="hero__trust">
          {
            trust.map((item) => (
              <li class="hero__trust-item">
                <span class="hero__tick" aria-hidden="true">
                  ✓
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero__aside" id="lead">
        <Eyebrow>{formEyebrow}</Eyebrow>

        <LeadForm heading={formHeading} intro={formIntro} headingLevel={2} />

        <p class="hero__tel">
          <span>או התקשרו ישירות:</span>
          <TelLink variant="plain" showIcon={false} />
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--s-5) 0;
  }

  .hero__slab {
    background: var(--c-bg-tint);
  }

  .hero__grid {
    display: grid;
    gap: var(--s-8);
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (width >= 900px) {
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--s-9);
    }
  }

  .hero__main {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }

  .hero__lead {
    max-inline-size: 52ch;
  }

  /* A class handed to a child component lands on that component's root,
     which never carries this file's scope id — hence :global here only. */
  :global(.hero__media) {
    margin-block-start: var(--s-1);
  }

  /* 2×2 white trust pills on the tinted slab. */
  .hero__trust {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin: 0;
    padding: 0;
  }

  .hero__trust-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    align-items: start;
    padding: var(--s-3) var(--s-4);
    background: var(--c-surface);
    border-radius: var(--r-3);
    font-family: var(--ff-head);
    font-size: var(--fs-sm);
    font-weight: var(--fw-med);
    line-height: var(--lh-h3);
    color: var(--c-heading);
  }

  .hero__tick {
    color: var(--c-link);
    font-weight: var(--fw-black);
  }

  /* The lead column. LeadForm supplies its own navy panel; nesting a second
     one behind it would stack two dark surfaces. */
  .hero__aside {
    display: grid;
    gap: var(--s-4);
    align-content: center;
  }

  .hero__tel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--c-text-strong);
  }




  /* Mobile (sketch P1, 390px): heading, media, lead, form, then the ticks —
     the form stays inside the first screenful. */
  @media (width <= 899px) {
    .hero__grid {
      display: flex;
      flex-direction: column;
      gap: var(--s-6);
    }

    .hero__main {
      display: contents;
    }

    .hero__title {
      order: 1;
    }

    :global(.hero__media) {
      order: 2;
    }

    .hero__lead {
      order: 3;
    }

    .hero__aside {
      order: 4;
    }

    .hero__trust {
      order: 5;
    }
  }
</style>
