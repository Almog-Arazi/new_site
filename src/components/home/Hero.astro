---
import LeadForm from '../form/LeadForm.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import TelLink from '../ui/TelLink.astro';

/* Homepage hero (sketch P1). This is the one page whose <h1> does not come
   from PageHead — the homepage has no breadcrumb and pairs the heading with
   a lead-capture panel, so it uses a bespoke head, exactly as the frozen
   ArticleLayout does. Still exactly one <h1> in the document.

   The backdrop is a seamless ping-pong loop: the camera orbits the crane, then
   returns, forever. The palindrome lives in the encode — forward frames plus
   the reversed frames with the duplicated seam frames dropped — so the browser
   only has to `loop` a normal video. A negative playbackRate is not supported
   anywhere, so reversing in script would stutter.

   The video is scoped to this section rather than fixed behind the page: every
   section below is opaque, so a page-wide backdrop would be megabytes of
   pixels nobody sees. It is fetched only when the visitor is on a wide screen,
   has not asked for reduced motion, and is not on Save-Data. Everyone else
   gets the poster, which is also the LCP element either way.
*/

interface Props {
  h1: string;
  lead: string;
  trust: string[];
  poster?: string;
  video?: string;
  videoMobile?: string;
  formEyebrow?: string;
  formHeading?: string;
  formIntro?: string;
}

const {
  h1,
  lead,
  trust,
  poster = '/uploads/hero-poster-mid.webp',
  video = '/hero-loop.mp4',
  videoMobile = '/hero-loop-mobile.mp4',
  formEyebrow = 'תיאום בדיקה · 30 שניות',
  formHeading = 'נחזור אליכם עם זמינות ומחיר',
  formIntro = 'חמישה שדות בלבד. נחזור אליכם עם זמינות ומחיר לבדיקה.',
} = Astro.props;
---

<section class="hero" data-hero>
  <div class="hero__bg" style={`background-image:url(${poster})`} aria-hidden="true">
    <video
      class="hero__video"
      data-hero-video
      data-src={video}
      data-src-mobile={videoMobile}
      poster={poster}
      muted
      loop
      autoplay
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"></video>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__main">
    <h1 class="hero__title">{h1}</h1>
    <p class="hero__lead">{lead}</p>

    <ul role="list" class="hero__trust">
      {
        trust.map((item) => (
          <li class="hero__trust-item">
            <span class="hero__tick" aria-hidden="true">
              ✓
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="hero__aside" id="lead">
    <Eyebrow>{formEyebrow}</Eyebrow>
    <LeadForm heading={formHeading} intro={formIntro} headingLevel={2} />
    <p class="hero__tel">
      <span>או התקשרו ישירות:</span>
      <TelLink variant="plain" showIcon={false} />
    </p>
  </div>
</section>

<script>
  import '../../scripts/hero-loop';
</script>

<style>
  /* Two layouts, one DOM.
     Narrow: two stacked rows. The footage is a grid item pinned to row 1, so
     it is exactly as tall as the headline block and stops there; the form
     sits below it on flat navy. That is the point — a phone-height frame
     shared between text and a form panel left the video as a sliver behind
     the panel, which is not a video, it is a texture.
     Wide: one row, two columns, and the footage goes back to absolute so it
     spans the whole section behind both columns. */
  .hero {
    display: grid;
    grid-template-rows: auto auto;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-end-start-radius: var(--r-hero);
    border-end-end-radius: var(--r-hero);
    background: var(--c-bg-dark);
  }

  .hero__bg,
  .hero__scrim {
    grid-area: 1 / 1;
    z-index: -1;
  }

  .hero__bg {
    background-size: cover;
    background-position: center;
  }

  .hero__video {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-slower) var(--ease);
  }

  .hero[data-loop-ready] .hero__video {
    opacity: 1;
  }

  /* Contrast where the words are, clear glass everywhere else.
     The page is RTL-only, so these gradients are authored right-to-left on
     purpose: the headline column sits on the inline-start (right) edge and
     needs cover, while the middle and left open up onto the footage.
     A flat wash would have been simpler and would have hidden the crane. */
  .hero__scrim {
    background:
      linear-gradient(
        to left,
        var(--c-video-scrim-text) 0%,
        var(--c-video-scrim-text) 22%,
        var(--c-video-scrim-mid) 46%,
        var(--c-video-scrim-open) 68%
      ),
      linear-gradient(to bottom, transparent 55%, var(--c-video-scrim-bottom)),
      radial-gradient(140% 100% at 92% 45%, transparent 30%, var(--c-video-vignette)),
      linear-gradient(var(--c-video-scrim-floor), var(--c-video-scrim-floor));
  }


  .hero__main {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }

  .hero__title {
    font-size: var(--fs-hero);
    line-height: var(--lh-hero);
    letter-spacing: var(--ls-hero);
    color: var(--c-white);
    text-wrap: balance;
  }

  .hero__lead {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--c-on-dark);
    max-inline-size: 52ch;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
  }

  .hero__trust-item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: var(--tap);
    padding: var(--s-2) var(--s-4);
    font-family: var(--ff-head);
    font-size: var(--fs-sm);
    font-weight: var(--fw-med);
    color: var(--c-white);
    background: var(--c-on-dark-surface);
    border: 1px solid var(--c-border-dark);
    border-radius: var(--r-pill);
  }

  .hero__tick {
    color: var(--c-accent-dark);
    font-weight: var(--fw-black);
  }

  .hero__aside {
    grid-area: 2 / 1;
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  /* Monospace on footage read as a caption, not a promise. Display face on a
     white pill instead: the orange is #C25309 on white, 4.63:1, so it holds
     AA no matter what frame is behind it. */
  .hero__aside :global(.t-eyebrow) {
    display: inline-flex;
    align-items: center;
    padding: var(--s-2) var(--s-5);
    font-family: var(--ff-head);
    font-size: var(--fs-sm);
    font-weight: var(--fw-black);
    letter-spacing: 0;
    color: var(--c-action);
    background: var(--c-white);
    border-radius: var(--r-pill);
    box-shadow: var(--e-1);
  }

  .hero__tel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--c-on-dark);
  }

  /* One screen, no scrolling to reach the bottom of the form. The section is
     sized to the viewport and the content is centred inside it; the form was
     the tall part and is paired into two columns to fit. */
  @media (width >= 901px) {
    .hero {
      grid-template-rows: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-content: center;
      align-items: center;
      column-gap: var(--s-8);
      min-block-size: 100svh;
      padding-block: var(--s-7);
      /* Emulates .container: the two columns need the same measure as every
         other section, but the footage behind them must stay full-bleed, so
         the container cannot be a wrapper element here.
         The `+ var(--gutter)` is load-bearing. `.container` is border-box, so
         its 1160px includes its own 32px gutters and the content box is 1096.
         Centring on 1160 alone hands each column 32px it never had, which is
         enough to pull the h1 from three lines onto two. */
      padding-inline: max(
        var(--gutter),
        calc((100% - var(--container)) / 2 + var(--gutter))
      );
    }

    /* Back out of the grid so the footage spans behind both columns and
       ignores the section's padding. */
    .hero__bg,
    .hero__scrim {
      position: absolute;
      inset: 0;
      grid-area: auto;
    }

    .hero__main {
      grid-area: auto;
      gap: var(--s-4);
    }

    .hero__aside {
      grid-area: auto;
    }
  }

  /* Narrow overrides live last on purpose: several of them restate a base
     property at the same specificity, so source order is what decides. */
  @media (width <= 900px) {
    /* Sized by the h1 and the ticks, which sit on it directly. Measured over
       108 frames at 6fps: 3.36:1 for the 27px h1 in its band (needs 3.0) and
       4.89:1 for the 16px ticks in theirs (needs 4.5). Lighter than this and
       the ticks fail; at 45/38/74 they measure 4.00. The last stop is the
       heaviest so the frame hands over to the navy under the form instead of
       ending on a cut line. */
    .hero__scrim {
      background: linear-gradient(
        to bottom,
        var(--c-video-scrim-m-top) 0%,
        var(--c-video-scrim-m-mid) 42%,
        var(--c-video-scrim-m-bottom) 100%
      );
    }

    /* The frame keeps a minimum height of its own, so the footage is not
       reduced to whatever the text happens to leave over.

       It also sweeps at the bottom, the way the whole section does on a wide
       screen. There the footage runs to the section's own rounded edge; here
       the form sits below it, so the footage needs the curve itself or it
       ends on a straight cut halfway down the page. overflow is what makes
       the radius bite — the <video> inside would otherwise paint over it. */
    .hero__bg,
    .hero__scrim {
      overflow: hidden;
      border-end-start-radius: var(--r-hero);
      border-end-end-radius: var(--r-hero);
    }

    .hero__bg {
      min-block-size: 62svh;
    }

    .hero__main {
      align-content: center;
      gap: var(--s-6);
      min-block-size: 66svh;
      padding: var(--s-9) var(--gutter) var(--s-10);
    }

    .hero__aside {
      padding: var(--s-8) var(--gutter) var(--s-9);
    }

    /* Hebrew at 27–34px sets tighter than Latin does; 1.15 is right on a
       desktop measure and cramped across three phone lines. */
    .hero__title {
      line-height: 1.24;
    }

    /* Only this paragraph gets glass. It is the smallest type in the block
       and the only line that failed on the footage: 19px in --c-on-dark
       measured 3.98:1 over the brightest frames, against the 4.5:1 it needs.
       On the panel it measures 7.76:1. Darkening the whole wash instead
       would have carried it too, and turned the video into a texture.

       The blur is not in that number — backdrop-filter earns no contrast
       credit, so a browser without it loses nothing that matters. */
    .hero__lead {
      padding: var(--s-5);
      line-height: 1.7;
      max-inline-size: none;
      background: var(--c-hero-panel);
      border: 1px solid var(--c-border-dark);
      border-radius: var(--r-4);
      backdrop-filter: blur(6px);
    }

    /* Four wrapped pills on a 390px screen come out as a ragged cloud with
       one orphan on the last row. Stacked ticks with no chrome read as a
       list, take a third less height, and let the footage through. */
    .hero__trust {
      display: grid;
      justify-items: start;
      gap: var(--s-3);
    }

    .hero__trust-item {
      min-block-size: 0;
      padding: 0;
      font-size: var(--fs-body);
      background: none;
      border: 0;
    }
  }
</style>
