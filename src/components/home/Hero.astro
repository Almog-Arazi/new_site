---
import LeadForm from '../form/LeadForm.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import TelLink from '../ui/TelLink.astro';

/* Homepage hero (sketch P1). This is the one page whose <h1> does not come
   from PageHead — the homepage has no breadcrumb and pairs the heading with
   a lead-capture panel, so it uses a bespoke head, exactly as the frozen
   ArticleLayout does. Still exactly one <h1> in the document.

   The backdrop is a seamless ping-pong loop: the camera orbits the crane, then
   returns, forever. The palindrome lives in the encode — forward frames plus
   the reversed frames with the duplicated seam frames dropped — so the browser
   only has to `loop` a normal video. A negative playbackRate is not supported
   anywhere, so reversing in script would stutter.

   The video is scoped to this section rather than fixed behind the page: every
   section below is opaque, so a page-wide backdrop would be megabytes of
   pixels nobody sees. It is fetched only when the visitor is on a wide screen,
   has not asked for reduced motion, and is not on Save-Data. Everyone else
   gets the poster, which is also the LCP element either way.
*/

interface Props {
  h1: string;
  lead: string;
  trust: string[];
  poster?: string;
  video?: string;
  formEyebrow?: string;
  formHeading?: string;
  formIntro?: string;
}

const {
  h1,
  lead,
  trust,
  poster = '/uploads/hero-poster-mid.webp',
  video = '/hero-loop.mp4',
  formEyebrow = 'תיאום בדיקה · 30 שניות',
  formHeading = 'נחזור אליכם עם זמינות ומחיר',
  formIntro = 'חמישה שדות בלבד. נחזור אליכם עם זמינות ומחיר לבדיקה.',
} = Astro.props;
---

<section class="hero" data-hero>
  <div class="hero__bg" style={`background-image:url(${poster})`} aria-hidden="true">
    <video
      class="hero__video"
      data-hero-video
      data-src={video}
      poster={poster}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"></video>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <button type="button" class="hero__toggle" data-hero-toggle hidden aria-pressed="false">
    <span class="hero__toggle-icon" aria-hidden="true"></span>
  </button>

  <div class="container hero__grid">
    <div class="hero__main">
      <h1 class="hero__title">{h1}</h1>
      <p class="hero__lead">{lead}</p>

      <ul role="list" class="hero__trust">
        {
          trust.map((item) => (
            <li class="hero__trust-item">
              <span class="hero__tick" aria-hidden="true">
                ✓
              </span>
              {item}
            </li>
          ))
        }
      </ul>

    </div>

    <div class="hero__aside" id="lead">
      <Eyebrow>{formEyebrow}</Eyebrow>
      <LeadForm heading={formHeading} intro={formIntro} headingLevel={2} />
      <p class="hero__tel">
        <span>או התקשרו ישירות:</span>
        <TelLink variant="plain" showIcon={false} />
      </p>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hero-loop';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--s-9) var(--s-10);
    border-end-start-radius: var(--r-6);
    border-end-end-radius: var(--r-6);
    background: var(--c-bg-dark);
  }

  .hero__bg,
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__bg {
    background-size: cover;
    background-position: center;
  }

  .hero__video {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-slower) var(--ease);
  }

  .hero[data-loop-ready] .hero__video {
    opacity: 1;
  }

  /* WCAG 2.2.2 — motion that starts on its own and never ends needs a stop. */
  .hero__toggle {
    position: absolute;
    inset-block-end: var(--s-5);
    inset-inline-end: var(--s-5);
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: var(--tap);
    block-size: var(--tap);
    border-radius: var(--r-pill);
    background: var(--c-on-dark-surface);
    border: 1px solid var(--c-border-dark);
    backdrop-filter: blur(6px);
  }

  .hero__toggle:hover {
    background: var(--c-on-dark-surface-hover);
  }

  .hero__toggle:focus-visible {
    outline: none;
    box-shadow: var(--ring-on-dark);
  }

  .hero__toggle-icon {
    inline-size: 12px;
    block-size: 14px;
    background: var(--c-white);
    clip-path: polygon(0 0, 35% 0, 35% 100%, 0 100%, 0 0, 65% 0, 100% 0, 100% 100%, 65% 100%, 65% 0);
  }

  .hero__toggle[data-playing='false'] .hero__toggle-icon {
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  /* Contrast where the words are, clear glass everywhere else.
     The page is RTL-only, so these gradients are authored right-to-left on
     purpose: the headline column sits on the inline-start (right) edge and
     needs cover, while the middle and left open up onto the footage.
     A flat wash would have been simpler and would have hidden the crane. */
  .hero__scrim {
    background:
      linear-gradient(
          to left,
          var(--c-video-scrim-text) 0%,
          var(--c-video-scrim-text) 22%,
          var(--c-video-scrim-mid) 46%,
          var(--c-video-scrim-open) 68%
        ),
      linear-gradient(to bottom, transparent 55%, var(--c-video-scrim-bottom)),
      radial-gradient(140% 100% at 92% 45%, transparent 30%, var(--c-video-vignette)),
      linear-gradient(var(--c-video-scrim-floor), var(--c-video-scrim-floor));
  }

  @media (width <= 900px) {
    /* One column: the text sits over the whole frame, so the directional
       gradient has nothing to clear toward. */
    .hero__scrim {
      background:
        linear-gradient(to bottom, var(--c-video-scrim-text), var(--c-video-scrim-bottom));
    }
  }

  .hero__grid {
    display: grid;
    gap: var(--s-9);
    align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  }

  /* One screen, no scrolling to reach the bottom of the form. The section is
     sized to the viewport and the content is centred inside it; the form was
     the tall part and is paired into two columns to fit. */
  @media (width >= 900px) {
    .hero {
      display: grid;
      align-content: center;
      min-block-size: 100svh;
      padding-block: var(--s-7);
    }

    .hero__grid {
      gap: var(--s-8);
    }

    .hero__main {
      gap: var(--s-4);
    }
  }


  .hero__main {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }

  .hero__title {
    font-size: var(--fs-hero);
    line-height: var(--lh-hero);
    letter-spacing: var(--ls-hero);
    color: var(--c-white);
    text-wrap: balance;
  }

  .hero__lead {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--c-on-dark);
    max-inline-size: 52ch;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
  }

  .hero__trust-item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: var(--tap);
    padding: var(--s-2) var(--s-4);
    font-family: var(--ff-head);
    font-size: var(--fs-sm);
    font-weight: var(--fw-med);
    color: var(--c-white);
    background: var(--c-on-dark-surface);
    border: 1px solid var(--c-border-dark);
    border-radius: var(--r-pill);
  }

  .hero__tick {
    color: var(--c-accent-dark);
    font-weight: var(--fw-black);
  }


  .hero__aside {
    display: grid;
    gap: var(--s-4);
  }

  .hero__tel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--c-on-dark);
  }

  @media (width <= 900px) {
    .hero {
      padding-block: var(--s-7) var(--s-8);
    }
  }
</style>
