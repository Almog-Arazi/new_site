---
import { getCollection } from 'astro:content';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import ArticleGrid from '../blog/ArticleGrid.astro';

/* Renders whatever exists — one article or seven. Hidden entirely when the
   collection is empty, so the homepage never shows a bare heading. */

interface Props {
  heading?: string;
  intro?: string;
  limit?: number;
  moreHref?: string;
  moreLabel?: string;
}

const {
  heading = 'מידע מקצועי בתחום בדיקות ציוד הרמה',
  intro = 'מאמרים שנכתבים מתוך עבודה בשטח, למנהלי אחזקה וממוני בטיחות.',
  limit = 3,
  moreHref = '/blog',
  moreLabel = 'לכל המאמרים',
} = Astro.props;

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, limit);
---

{
  articles.length > 0 && (
    <Section>
      <header class="split arts__head">
        <div class="arts__headings">
          <h2>{heading}</h2>
          <p class="t-lead">{intro}</p>
        </div>
        <a href={moreHref} class="arts__all">
          {moreLabel}
          <Icon name="arrow" size={18} />
        </a>
      </header>
      <ArticleGrid articles={articles} columns={3} />
    </Section>
  )
}

<style>
  .arts__head {
    margin-block-end: var(--s-8);
    align-items: end;
  }

  .arts__headings {
    display: grid;
    gap: var(--s-3);
  }

  .arts__all {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: var(--tap);
    font-family: var(--ff-head);
    font-weight: var(--fw-bold);
    font-size: var(--fs-sm);
    color: var(--c-link);
  }

  .arts__all:hover {
    color: var(--c-action-ink);
  }
</style>
