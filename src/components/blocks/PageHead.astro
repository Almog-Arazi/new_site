---
import Breadcrumb from '../chrome/Breadcrumb.astro';
import PhotoFrame from '../media/PhotoFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import TelLink from '../ui/TelLink.astro';
import type { PlaceholderVariant } from '../placeholders/index';

/* The ONLY component in the codebase allowed to emit <h1>. */
interface Props {
  eyebrow?: string;
  h1: string;
  lead: string;
  breadcrumb?: { label: string; href: string }[];
  breadcrumbLabel: string;
  hero?: { placeholder: PlaceholderVariant; alt: string; note?: string };
}

const { eyebrow, h1, lead, breadcrumb = [], breadcrumbLabel, hero } = Astro.props;
---

<section class="pagehead">
  <div class="section__slab">
    <div class="container pagehead__grid">
      <div class="pagehead__text">
        <Breadcrumb trail={breadcrumb} current={breadcrumbLabel} />
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <h1>{h1}</h1>
        <p class="t-lead">{lead}</p>
        <div class="cluster">
          <Button href="/contact" variant="primary" size="lg">תיאום בדיקה</Button>
          <TelLink variant="plain" label="דברו איתנו עכשיו" />
        </div>
      </div>
      {hero && (
        <PhotoFrame
          variant={hero.placeholder}
          alt={hero.alt}
          note={hero.note}
          ratio="card"
          eager
          class="pagehead__media"
        />
      )}
    </div>
  </div>
</section>

<style>
  .pagehead {
    padding-block: var(--s-5) 0;
  }

  .pagehead .section__slab {
    background: var(--c-bg-tint);
  }

  .pagehead__grid {
    display: grid;
    gap: var(--s-8);
    align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .pagehead__text {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
</style>
