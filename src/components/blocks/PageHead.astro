---
import Breadcrumb from '../chrome/Breadcrumb.astro';
import PhotoFrame from '../media/PhotoFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import TelLink from '../ui/TelLink.astro';
import type { PlaceholderVariant } from '../placeholders/index';

/* The ONLY component in the codebase allowed to emit <h1>. One per page,
   always — check-html fails the build on a second one. */
interface Props {
  eyebrow?: string;
  h1: string;
  lead: string;
  breadcrumb?: { label: string; href: string }[];
  breadcrumbLabel: string;
  hero?: { placeholder: PlaceholderVariant; alt: string; note?: string; image?: string };
  /**
   * Legal pages: no tinted slab, no hero, no CTA cluster. A privacy policy
   * that opens with a "תיאום בדיקה" button reads as a sales page.
   */
  compact?: boolean;
}

const {
  eyebrow,
  h1,
  lead,
  breadcrumb = [],
  breadcrumbLabel,
  hero,
  compact = false,
} = Astro.props;

const showHero = Boolean(hero) && !compact;
---

<section class:list={['pagehead', compact && 'pagehead--compact']}>
  <div class="section__slab">
    <div class:list={['container', compact && 'container--narrow', 'pagehead__grid']}>
      <div class="pagehead__text">
        <Breadcrumb trail={breadcrumb} current={breadcrumbLabel} />
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <h1>{h1}</h1>
        <p class="t-lead pagehead__lead">{lead}</p>
        {
          !compact && (
            <div class="cluster pagehead__actions">
              <Button href="/contact" variant="primary" size="lg">
                תיאום בדיקה
              </Button>
              <TelLink variant="plain" label="דברו איתנו עכשיו" />
            </div>
          )
        }
      </div>

      {
        showHero && hero && (
          <PhotoFrame
            variant={hero.placeholder}
            alt={hero.alt}
            note={hero.note}
            image={hero.image}
            ratio="card"
            eager
            class="pagehead__media"
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .pagehead {
    padding-block: var(--s-5) 0;
  }

  .pagehead .section__slab {
    background: var(--c-bg-tint);
  }

  .pagehead__grid {
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }

  /* Two columns only when there is something to put in the second one. */
  @media (width >= 900px) {
    .pagehead__grid:has(.pagehead__media) {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--s-10);
    }
  }

  .pagehead__text {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .pagehead__lead {
    margin: 0;
  }

  .pagehead__actions {
    margin-block-start: var(--s-2);
  }

  /* ── compact (legal) ───────────────────────────────────────── */
  .pagehead--compact {
    padding-block: var(--s-5) 0;
  }

  .pagehead--compact .section__slab {
    background: transparent;
    padding-block-end: 0;
  }
</style>
