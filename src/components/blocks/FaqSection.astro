---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import JsonLd from '../seo/JsonLd.astro';
import { getFaqFor, getFaqGroups, type FaqGroup, type FaqItem } from '../../lib/faq';
import { faqPage } from '../../lib/schema';
import { normalise } from '../../lib/nav';
import type { Section as Block } from '../../content.config';

/* ============================================================
   THE single source of FAQ truth.

   One array of items reaches this component, and from that one array it
   renders the accordion AND emits the FAQPage JSON-LD. There is nothing to
   keep in sync because there is only one list: a question that is not on
   the screen cannot reach the schema, and a question in the schema is
   always readable on the page.

   Never hand-write FAQ schema anywhere else.
   ============================================================ */

type Props = Omit<Extract<Block, { type: 'faq' }>, 'tone' | 'groups'> & {
  tone?: Extract<Block, { type: 'faq' }>['tone'];
  groups?: string[];
  /** Pre-resolved items from a template that already looked them up. Wins over `groups`. */
  items?: FaqItem[];
  /** `grouped` renders an <h2> per topic with its questions as <h3>. */
  variant?: 'flat' | 'grouped';
  emitSchema?: boolean;
};

const {
  heading = 'שאלות נפוצות',
  intro,
  groups = [],
  limit,
  moreHref,
  tone = 'light',
  items: given,
  variant = 'flat',
  emitSchema = true,
} = Astro.props;

const grouped = variant === 'grouped';

/* Grouped mode resolves groups because it needs the topic titles, but the
   schema is still built from the flattened result — so both modes emit
   exactly, and only, what they render. */
let topics: FaqGroup[] = [];
let items: FaqItem[] = [];

if (grouped) {
  topics = (await getFaqGroups(groups)).filter((group) => group.items.length > 0);
  items = topics.flatMap((group) => group.items);
} else if (given) {
  items = limit ? given.slice(0, limit) : given;
} else {
  items = await getFaqFor(groups, limit);
}

const path = normalise(Astro.url.pathname);
---

{
  items.length > 0 && (
    <Section tone={tone} id="faq">
      <SectionHeader heading={heading} intro={intro} />

      {grouped ? (
        <div class="faqgroups">
          {topics.map((group) => (
            <section class="faqgroup" id={`faq-${group.group}`}>
              <h2 class="faqgroup__title">{group.title}</h2>
              <div class="faq">
                {group.items.map((item) => (
                  <details class="faq__item">
                    <summary class="faq__q">
                      <h3>{item.q}</h3>
                      <span class="faq__caret" aria-hidden="true">
                        <Icon name="chevron" size={20} />
                      </span>
                    </summary>
                    <div class="faq__a">
                      <p set:html={item.aHtml} />
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <div class="faq">
          {items.map((item, i) => (
            <details class="faq__item" open={i === 0}>
              <summary class="faq__q">
                <h3>{item.q}</h3>
                <span class="faq__caret" aria-hidden="true">
                  <Icon name="chevron" size={20} />
                </span>
              </summary>
              <div class="faq__a">
                <p set:html={item.aHtml} />
              </div>
            </details>
          ))}
        </div>
      )}

      {moreHref && (
        <p class="faq__more">
          <a href={moreHref}>
            <span>לכל השאלות הנפוצות</span>
            <Icon name="arrow" size={18} />
          </a>
        </p>
      )}
    </Section>
  )
}

{emitSchema && items.length > 0 && <JsonLd data={faqPage(items, path)} />}

<style>
  /* ── the accordion ────────────────────────────────────────────
     Hairline-separated rows inside one panel, not a stack of shadowed
     boxes.

     `<details>` deliberately carries NO `name` attribute. A named group is
     mutually exclusive, which is wrong here on three counts: a visitor
     comparing "כל כמה זמן נדרשת בדיקה" against "מה קורה אם התסקיר פג" needs
     both answers open at once; on a fourteen-question page every click
     silently collapsing a distant row reads as a bug; and on the grouped
     FAQ page an exclusive group would close the row a topic anchor had just
     scrolled to, yanking the target out from under the scroll position.
     Independent toggles cost nothing — the schema is emitted from the data,
     not from the open state.
     ──────────────────────────────────────────────────────────── */
  .faq {
    border: var(--hairline);
    border-radius: var(--r-4);
    background: var(--c-surface);
    overflow: hidden;
  }

  .faq__item + .faq__item {
    border-block-start: var(--hairline);
  }

  .faq__item[open] {
    background: var(--c-bg-tint);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-block-size: var(--tap-lg);
    padding: var(--s-5) var(--card-pad);
    cursor: pointer;
    /* Safari draws the native marker on the physical left. Hide it and draw
       our own caret on the inline-end side. */
    list-style: none;
    transition: background-color var(--dur) var(--ease);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    background: var(--c-bg-soft);
  }

  .faq__q h3 {
    margin: 0;
    font-size: var(--fs-h3);
    color: var(--c-heading);
  }

  /* Our marker, drawn by us — see the note on `.faq__q` above. A bare chevron:
     the caret is a state indicator, not an ornament. */
  .faq__caret {
    display: inline-grid;
    place-items: center;
    flex: none;
    color: var(--c-link);
    transform: rotate(-90deg);
    transition: transform var(--dur-slow) var(--ease);
  }

  .faq__item[open] .faq__caret {
    transform: rotate(90deg);
  }

  .faq__q:focus-visible {
    outline: none;
    box-shadow: var(--ring);
    border-radius: var(--r-3);
  }

  .faq__a {
    padding: 0 var(--card-pad) var(--s-6);
  }

  .faq__a p {
    max-inline-size: var(--measure);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .faq__a :global(a) {
    color: var(--c-link);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .faq__more {
    margin-block-start: var(--s-5);
    font-family: var(--ff-head);
    font-weight: var(--fw-bold);
  }

  .faq__more a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: var(--tap);
    color: var(--c-action-ink);
    text-decoration: none;
  }

  .faq__more a:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  /* ── grouped layout ────────────────────────────────────────── */
  .faqgroups {
    display: grid;
    gap: var(--s-10);
  }

  .faqgroup {
    /* Clears the sticky header when a link jumps to a topic. */
    scroll-margin-block-start: var(--s-11);
  }

  .faqgroup__title {
    margin-block-end: var(--s-5);
    font-size: var(--fs-h2);
  }

  /* ── inside a dark slab ────────────────────────────────────── */
  :global(.section--dark) .faq {
    background: var(--c-on-dark-surface-soft);
    border-color: var(--c-border-dark);
  }

  :global(.section--dark) .faq__item + .faq__item {
    border-block-start: 1px solid var(--c-border-dark);
  }

  :global(.section--dark) .faq__item[open] {
    background: var(--c-on-dark-surface);
  }

  :global(.section--dark) .faq__q:hover {
    background: var(--c-on-dark-surface-hover);
  }

  :global(.section--dark) .faq__caret {
    color: var(--c-accent-dark);
  }

  :global(.section--dark) .faq__more a {
    color: var(--c-accent-dark);
  }
</style>
