---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import type { Section as Block } from '../../content.config';

type Props = Extract<Block, { type: 'featureGrid' }>;
const { eyebrow, heading, intro, items, tone } = Astro.props;
const isDark = tone === 'dark';
---

<Section tone={tone}>
  <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
  <div class="grid grid--3">
    {items.map((item, i) => (
      <Card tone={isDark ? 'dark' : 'surface'} accent={i === items.length - 1 ? 'orange' : 'blue'}>
        {item.icon && <Icon name={item.icon} size={28} class="feature__icon" />}
        <h3>{item.title}</h3>
        <p class="t-body">{item.text}</p>
      </Card>
    ))}
  </div>
</Section>

<style>
  .feature__icon {
    color: var(--c-link);
    margin-block-end: var(--s-3);
  }

  h3 {
    margin-block-end: var(--s-2);
  }
</style>
