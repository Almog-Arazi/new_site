---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import type { Section as Block } from '../../content.config';

type Props = Extract<Block, { type: 'statRow' }>;
const { heading, intro, stats, tone } = Astro.props;
---

<Section tone={tone}>
  <SectionHeader heading={heading} intro={intro} />
  <dl class="stats">
    {stats.map((stat) => (
      <div class="stats__item">
        <dt class="stats__value">{stat.value}</dt>
        <dd class="stats__label">{stat.label}{stat.note && <span class="t-sm"> · {stat.note}</span>}</dd>
      </div>
    ))}
  </dl>
</Section>

<style>
  .stats {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    margin: 0;
  }

  .stats__item {
    padding: var(--card-pad);
    background: var(--c-bg-tint);
    border-radius: var(--r-4);
  }

  .stats__value {
    font-family: var(--ff-head);
    font-size: var(--fs-hero);
    font-weight: var(--fw-black);
    line-height: 1;
    color: var(--c-heading);
  }

  .stats__label {
    margin: var(--s-2) 0 0;
    font-size: var(--fs-sm);
  }
</style>
