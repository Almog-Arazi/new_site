---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import type { Section as Block } from '../../content.config';

type Props = Extract<Block, { type: 'regulationTable' }>;
const { heading, intro, columns, rows, note, tone } = Astro.props;
---

<Section tone={tone}>
  <SectionHeader heading={heading} intro={intro} />
  <div class="table-wrap">
    <table>
      <thead>
        <tr>{columns.map((col) => <th scope="col">{col}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
        ))}
      </tbody>
    </table>
  </div>
  {note && <p class="t-sm table-note">{note}</p>}
</Section>

<style>
  /* Wide content scrolls inside its own container — the page body never does. */
  .table-wrap {
    overflow-x: auto;
    border: var(--hairline);
    border-radius: var(--r-3);
  }

  table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  th,
  td {
    padding: var(--s-4);
    text-align: start;
    border-block-end: var(--hairline);
  }

  thead th {
    background: var(--c-bg-tint);
    font-family: var(--ff-head);
    color: var(--c-heading);
  }

  tbody tr:last-child :is(th, td) {
    border-block-end: 0;
  }

  .table-note {
    margin-block-start: var(--s-3);
    color: var(--c-text);
  }
</style>
