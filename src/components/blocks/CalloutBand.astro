---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import type { Section as Block } from '../../content.config';

type Props = Extract<Block, { type: 'calloutBand' }>;
const { heading, text, cta, tone } = Astro.props;
---

<Section tone={tone}>
  <div class="callout">
    <div>
      <h2>{heading}</h2>
      {text && <p class="t-lead">{text}</p>}
    </div>
    {cta && (
      <Button href={cta.href} variant={cta.style === 'primary' ? 'primary' : 'secondary'} size="lg">
        {cta.label}
      </Button>
    )}
  </div>
</Section>

<style>
  .callout {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    align-items: center;
    justify-content: space-between;
  }

  .callout h2 {
    margin-block-end: var(--s-2);
  }
</style>
