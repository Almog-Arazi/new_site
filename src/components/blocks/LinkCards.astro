---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import PhotoFrame from '../media/PhotoFrame.astro';
import Icon from '../ui/Icon.astro';
import type { Section as Block } from '../../content.config';

type Props = Extract<Block, { type: 'linkCards' }>;
const { eyebrow, heading, intro, cards, tone } = Astro.props;
---

<Section tone={tone}>
  <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
  <div class="grid grid--3">
    {cards.map((card) => (
      <Card href={card.href} padded={false}>
        {card.placeholder && (
          <PhotoFrame variant={card.placeholder} alt={card.alt ?? card.title} ratio="wide" class="lc__media" />
        )}
        <div class="lc__body">
          <h3>{card.title}</h3>
          {card.text && <p class="t-body">{card.text}</p>}
          <span class="lc__more">
            לפרטים
            <Icon name="arrow" size={18} />
          </span>
        </div>
      </Card>
    ))}
  </div>
</Section>

<style>
  .lc__media {
    border-radius: 0;
    box-shadow: none;
  }

  .lc__body {
    display: grid;
    gap: var(--s-2);
    padding: var(--card-pad);
  }

  .lc__more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-block-start: var(--s-2);
    font-family: var(--ff-head);
    font-weight: var(--fw-bold);
    font-size: var(--fs-sm);
    color: var(--c-action-ink);
  }
</style>
