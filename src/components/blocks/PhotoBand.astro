---
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import PhotoFrame from '../media/PhotoFrame.astro';
import Button from '../ui/Button.astro';
import type { Section as Block } from '../../content.config';

type Props = Extract<Block, { type: 'photoBand' }>;
const { eyebrow, heading, body, bullets, placeholder, alt, note, image, flip, cta, tone } =
  Astro.props;

const variant = cta?.style === 'ghost' ? 'ghost' : cta?.style === 'secondary' ? 'secondary' : 'primary';
---

<Section tone={tone}>
  <div class:list={['band', flip && 'band--flip']}>
    <div class="band__text">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      {heading && <h2>{heading}</h2>}
      {body && <p class="t-lead">{body}</p>}
      {
        bullets.length > 0 && (
          <ul role="list" class="checks band__bullets">
            {bullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      {
        cta && (
          <p class="band__cta">
            <Button href={cta.href} variant={tone === 'dark' && variant !== 'primary' ? 'on-dark' : variant}>
              {cta.label}
            </Button>
          </p>
        )
      }
    </div>

    {/* `alt` is required by the schema, so every band ships meaningful Hebrew
        alternative text whether it is a placeholder or a real photograph. */}
    <PhotoFrame
      variant={placeholder}
      alt={alt}
      note={note}
      image={image}
      ratio="card"
      tone={tone === 'dark' ? 'dark' : 'tint'}
      class="band__media"
    />
  </div>
</Section>

<style>
  .band {
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }

  .band__text {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    max-inline-size: var(--measure);
  }

  .band__bullets {
    margin-block-start: var(--s-1);
  }

  .band__cta {
    margin-block-start: var(--s-2);
  }

  @media (width >= 900px) {
    .band {
      /* The text column leads; the frame is the quieter half. */
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--s-10);
    }

    /* `order` moves the frame to the other side of the inline axis and
       mirrors correctly under dir="rtl" — no physical property involved.
       Only applied here so the mobile stack always leads with the text. */
    .band--flip .band__media {
      order: -1;
    }
  }
</style>
