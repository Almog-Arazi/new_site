---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Prose from '../ui/Prose.astro';
import { renderBlock } from '../../lib/markdown';
import type { Section as Block } from '../../content.config';

type Props = Extract<Block, { type: 'richText' }>;
const { eyebrow, heading, body, tone, narrow } = Astro.props;
---

<Section tone={tone} width={narrow ? 'narrow' : 'default'}>
  <SectionHeader eyebrow={eyebrow} heading={heading} />
  <Prose html={renderBlock(body)} narrow={narrow} />
</Section>
