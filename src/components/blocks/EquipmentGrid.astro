---
import { getCollection } from 'astro:content';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import PhotoFrame from '../media/PhotoFrame.astro';
import Icon from '../ui/Icon.astro';
import type { Section as Block } from '../../content.config';

type Props = Extract<Block, { type: 'equipmentGrid' }>;
const { heading, intro, ids, tone } = Astro.props;

/* One dataset, four consumers: this grid, the chip picker, the footer and
   the lead form's equipment field. */
const all = (await getCollection('equipment')).sort((a, b) => a.data.order - b.data.order);

/* An explicit `ids` list is an editorial ordering, so it is honoured as one.
   Ids that no longer exist are dropped rather than rendered as a hole. */
const items = (
  ids.length ? ids.map((id) => all.find((entry) => entry.data.id === id)) : all
).filter((entry): entry is (typeof all)[number] => Boolean(entry));
---

{
  items.length > 0 && (
    <Section tone={tone}>
      <SectionHeader heading={heading} intro={intro} />

      <div class="eq">
        {items.map((item) => (
          <Card href={item.data.href} padded={false} class="eq__card">
            <PhotoFrame
              variant={item.data.placeholder}
              alt={item.data.alt}
              note={item.data.note}
              ratio="wide"
              class="eq__media"
            />
            <div class="eq__body">
              <h3>{item.data.label}</h3>
              <p class="t-body">{item.data.short}</p>
              <span class="eq__more">
                <span>לפרטים</span>
                <Icon name="arrow" size={18} />
              </span>
            </div>
          </Card>
        ))}
      </div>
    </Section>
  )
}

<style>
  .eq {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .eq__media {
    border-radius: 0;
    box-shadow: none;
  }

  .eq__body {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--card-pad);
  }

  .eq__body h3 {
    margin: 0;
  }

  .eq__more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-block-start: var(--s-1);
    font-family: var(--ff-head);
    font-weight: var(--fw-bold);
    font-size: var(--fs-sm);
    color: var(--c-action-ink);
    transition: gap var(--dur) var(--ease);
  }

  .eq__card:hover .eq__more {
    gap: var(--s-4);
  }

  /* ── inside a dark slab ────────────────────────────────────── */
  :global(.section--dark) .eq__more {
    color: var(--c-accent-dark);
  }
</style>
