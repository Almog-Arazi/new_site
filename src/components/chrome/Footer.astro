---
import site, { mailHref } from '../../site.config';
import { footerNav } from '../../lib/nav';
import Logo from '../media/Logo.astro';
import TelLink from '../ui/TelLink.astro';
import WaLink from '../ui/WaLink.astro';
import Icon from '../ui/Icon.astro';

/* PHASE 0 STUB — ownership passes to Stream A. */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo variant="mask" width={190} />
      <p class="site-footer__tagline">{site.tagline}</p>
      <p class="site-footer__area">{site.areaServedLabel} · {site.hours}</p>
    </div>

    {
      footerNav.map((group) => (
        <nav class="site-footer__col" aria-label={group.title}>
          <h2 class="site-footer__title">{group.title}</h2>
          <ul role="list">
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="site-footer__col">
      <h2 class="site-footer__title">יצירת קשר</h2>
      <ul role="list" class="site-footer__contact">
        <li><TelLink variant="plain" /></li>
        <li><WaLink variant="plain" /></li>
        <li>
          <a href={mailHref} class="site-footer__mail">
            <Icon name="mail" size={20} />
            <bdi class="ltr">{site.email}</bdi>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>© {year} {site.businessName}. כל הזכויות שמורות.</p>
    <a href="/privacy">מדיניות פרטיות</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--section-y);
    padding-block: var(--section-y);
    background: var(--c-bg-dark);
    color: var(--c-on-dark);
    border-start-start-radius: var(--r-6);
    border-start-end-radius: var(--r-6);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--grid-gap) var(--s-8);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }

  .site-footer__brand {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .site-footer__tagline {
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    max-inline-size: 34ch;
  }

  .site-footer__area {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--c-accent-dark);
  }

  .site-footer__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--c-white);
    margin-block-end: var(--s-4);
  }

  .site-footer__col ul {
    display: grid;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
  }

  .site-footer__col a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: var(--tap);
    font-size: var(--fs-sm);
    color: var(--c-on-dark);
    transition: color var(--dur) var(--ease);
  }

  .site-footer__col a:hover {
    color: var(--c-accent-dark);
  }

  .site-footer__mail {
    word-break: break-all;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    justify-content: space-between;
    align-items: center;
    margin-block-start: var(--s-9);
    padding-block-start: var(--s-6);
    border-block-start: 1px solid var(--c-border-dark);
    font-size: var(--fs-xs);
    color: var(--c-on-dark-muted);
  }

  .site-footer__legal a:hover {
    color: var(--c-accent-dark);
  }
</style>
