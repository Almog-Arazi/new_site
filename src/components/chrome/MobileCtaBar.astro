---
import site, { waHref } from '../../site.config';
import { displayPhone, telHrefFor } from '../../lib/format';
import Icon from '../ui/Icon.astro';

/* Fixed bottom bar, mobile only. base.css reserves the matching bottom
   padding on <body> below 900px so nothing hides underneath it. */

const phone = displayPhone(site.phoneE164);
const tel = telHrefFor(site.phoneE164);
---

<nav class="cta-bar" aria-label="יצירת קשר מהירה">
  <a href={tel} class="cta-bar__call" data-track="phone_click">
    <Icon name="phone" size={22} />
    <span>התקשרו עכשיו</span>
    <span class="vh"><bdi class="ltr num">{phone}</bdi></span>
  </a>

  <a
    href={waHref}
    class="cta-bar__wa"
    data-track="whatsapp_click"
    target="_blank"
    rel="noopener"
  >
    <Icon name="whatsapp" size={22} />
    <span>וואטסאפ</span>
    <span class="vh">{site.whatsappMessage}</span>
  </a>
</nav>

<style>
  .cta-bar {
    position: fixed;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: var(--z-bar);
    display: flex;
    gap: var(--s-2);
    padding: var(--s-3);
    padding-block-end: calc(var(--s-3) + env(safe-area-inset-bottom));
    background: var(--c-bg-dark);
    box-shadow: var(--e-bar);
    border-start-start-radius: var(--r-6);
    border-start-end-radius: var(--r-6);
  }

  .cta-bar a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-block-size: var(--tap-lg);
    min-inline-size: 0;
    font-family: var(--ff-head);
    font-size: var(--fs-btn);
    font-weight: var(--fw-bold);
    text-decoration: none;
    border-radius: var(--r-pill);
    transition:
      background-color var(--dur) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .cta-bar a:active {
    transform: translateY(var(--press));
  }

  .cta-bar__call {
    flex: 1.4;
    background: var(--c-action);
    color: var(--c-on-action);
  }

  .cta-bar__call:hover {
    background: var(--c-action-hover);
  }

  .cta-bar__wa {
    flex: 1;
    background: var(--c-on-dark-surface);
    color: var(--c-white);
    border: 1.5px solid var(--c-border-dark);
  }

  .cta-bar__wa:hover {
    background: var(--c-on-dark-surface-hover);
  }

  .cta-bar a:focus-visible {
    outline: none;
    box-shadow: var(--ring-on-dark);
  }

  /* Narrow phones: keep both labels on one line rather than wrapping. */
  @media (width <= 360px) {
    .cta-bar a {
      font-size: var(--fs-sm);
      gap: var(--s-1);
    }
  }

  @media (width >= 901px) {
    .cta-bar {
      display: none;
    }
  }
</style>
