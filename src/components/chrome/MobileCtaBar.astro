---
import site from '../../site.config';
import { displayPhone, telHrefFor } from '../../lib/format';
import { waHref } from '../../site.config';
import Icon from '../ui/Icon.astro';

/* PHASE 0 STUB — ownership passes to Stream A. */
---

<div class="cta-bar hide-desktop">
  <a href={telHrefFor(site.phoneE164)} class="cta-bar__call" data-track="phone_click">
    <Icon name="phone" size={22} />
    <span>התקשרו עכשיו</span>
    <span class="vh"><bdi class="ltr">{displayPhone(site.phoneE164)}</bdi></span>
  </a>
  <a href={waHref} class="cta-bar__wa" data-track="whatsapp_click" target="_blank" rel="noopener">
    <Icon name="whatsapp" size={22} />
    <span>וואטסאפ</span>
  </a>
</div>

<style>
  .cta-bar {
    position: fixed;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: var(--z-bar);
    display: flex;
    gap: var(--s-2);
    padding: var(--s-3);
    padding-block-end: calc(var(--s-3) + env(safe-area-inset-bottom));
    background: var(--c-bg-dark);
    box-shadow: var(--e-bar);
    border-start-start-radius: var(--r-6);
    border-start-end-radius: var(--r-6);
  }

  .cta-bar a {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-block-size: var(--tap-lg);
    font-family: var(--ff-head);
    font-size: var(--fs-btn);
    font-weight: var(--fw-bold);
    border-radius: var(--r-pill);
  }

  .cta-bar__call {
    flex: 1.4;
    background: var(--c-action);
    color: var(--c-on-action);
  }

  .cta-bar__wa {
    background: var(--c-on-dark-surface);
    color: var(--c-white);
    border: 1.5px solid var(--c-border-dark);
  }

  .cta-bar a:focus-visible {
    outline: none;
    box-shadow: var(--ring-on-dark);
  }

  @media (width >= 901px) {
    .cta-bar {
      display: none;
    }
  }
</style>
