---
import Logo from '../media/Logo.astro';
import Icon from '../ui/Icon.astro';
import Nav from './Nav.astro';
import MobileNav from './MobileNav.astro';
import site from '../../site.config';
import { displayPhone, telHrefFor } from '../../lib/format';

const pathname = Astro.url.pathname;
const phone = displayPhone(site.phoneE164);
const tel = telHrefFor(site.phoneE164);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${site.shortName}, לעמוד הבית`}>
      <Logo width={168} eager />
    </a>

    <Nav pathname={pathname} />

    <div class="site-header__actions">
      <a href={tel} class="site-header__phone" data-track="phone_click">
        <Icon name="phone" size={20} />
        <bdi class="ltr num site-header__number">{phone}</bdi>
        <span class="vh">התקשרו לתיאום בדיקה</span>
      </a>

      <button
        type="button"
        class="site-header__burger"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-haspopup="dialog"
        data-nav-toggle
      >
        <Icon name="menu" size={26} />
        <span class="vh">פתיחת התפריט</span>
      </button>
    </div>
  </div>

  <MobileNav pathname={pathname} />
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    background: var(--c-bg);
    border-block-end: var(--hairline);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-3);
  }

  .site-header__brand {
    flex: none;
    display: block;
    line-height: 0;
  }

  /* The logo lives in a child component, so it needs :global() to be resized
     from here. The width/height attributes stay on the <img>, so no CLS. */
  .site-header__brand :global(img.logo) {
    inline-size: clamp(124px, 22vw, 168px);
    block-size: auto;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex: none;
  }

  /* Orange pill — a surface colour carrying a white 700 label, never
     orange text on white. */
  .site-header__phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-block-size: var(--tap);
    padding-inline: var(--s-4);
    font-family: var(--ff-head);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--c-on-action);
    background: var(--c-action);
    border-radius: var(--r-pill);
    text-decoration: none;
    box-shadow: var(--e-action);
    transition:
      background-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .site-header__phone:hover {
    background: var(--c-action-hover);
    box-shadow: var(--e-action-hover);
    transform: translateY(var(--lift));
  }

  .site-header__phone:active {
    transform: translateY(var(--press));
  }

  .site-header__number {
    font-size: var(--fs-sm);
  }

  .site-header__burger {
    display: inline-grid;
    place-items: center;
    inline-size: var(--tap);
    block-size: var(--tap);
    color: var(--c-heading);
    background: var(--c-bg-soft);
    border-radius: var(--r-pill);
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .site-header__burger:hover {
    background: var(--c-bg-tint);
    color: var(--c-link);
  }

  .site-header :is(a, button):focus-visible {
    outline: none;
    box-shadow: var(--ring);
  }

  /* Under 420px the number pushes the burger off the row, so the pill
     collapses to its icon and the number survives in the accessible name. */
  @media (width <= 420px) {
    .site-header__number {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .site-header__phone {
      padding-inline: var(--s-3);
    }
  }

  /* The desktop nav appears at 1080px, not at the 900px utility breakpoint:
     seven top-level items plus the logo and the phone pill do not fit any
     earlier without wrapping. */
  @media (width >= 1080px) {
    .site-header__burger {
      display: none;
    }

    .site-header__inner {
      gap: var(--s-6);
      padding-block: var(--s-4);
    }

    .site-header__phone {
      min-block-size: var(--tap-lg);
      padding-inline: var(--s-6);
      font-size: var(--fs-btn);
    }

    .site-header__number {
      font-size: var(--fs-btn);
    }
  }
</style>
