---
interface Props {
  trail: { label: string; href: string }[];
  current: string;
  tone?: 'light' | 'dark';
}

const { trail, current, tone = 'light' } = Astro.props;
---

<nav class:list={['crumb', tone === 'dark' && 'crumb--dark']} aria-label="מסלול ניווט">
  <ol role="list">
    {
      trail.map((step) => (
        <li>
          <a href={step.href}>{step.label}</a>
          <span aria-hidden="true" class="crumb__sep">
            /
          </span>
        </li>
      ))
    }
    <li aria-current="page">{current}</li>
  </ol>
</nav>

<style>
  .crumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--c-text);
  }

  .crumb li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .crumb a {
    color: inherit;
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--c-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .crumb__sep {
    color: var(--c-text-muted);
  }

  .crumb--dark ol {
    color: var(--c-on-dark-muted);
  }

  .crumb--dark a:hover {
    color: var(--c-accent-dark);
  }
</style>
