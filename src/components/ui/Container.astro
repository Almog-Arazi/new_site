---
interface Props {
  size?: 'default' | 'narrow' | 'wide';
  as?: string;
  class?: string;
}
const { size = 'default', as: Tag = 'div', class: className } = Astro.props;
---

<Tag
  class:list={[
    'container',
    size === 'narrow' && 'container--narrow',
    size === 'wide' && 'container--wide',
    className,
  ]}
>
  <slot />
</Tag>
