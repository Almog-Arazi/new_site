---
import site from '../../site.config';
import { displayPhone, telHrefFor } from '../../lib/format';
import Icon from './Icon.astro';

interface Props {
  variant?: 'plain' | 'button' | 'row';
  label?: string;
  showIcon?: boolean;
  class?: string;
}

const { variant = 'plain', label, showIcon = true, class: className } = Astro.props;
const number = displayPhone(site.phoneE164);
---

<a
  href={telHrefFor(site.phoneE164)}
  class:list={['tel', `tel--${variant}`, className]}
  data-track="phone_click"
>
  {showIcon && <Icon name="phone" size={20} />}
  <span class="tel__text">
    {label ?? <bdi class="ltr num">{number}</bdi>}
  </span>
</a>

<style>
  .tel {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: var(--tap);
    color: inherit;
    font-family: var(--ff-head);
    font-weight: var(--fw-bold);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .tel--plain:hover {
    color: var(--c-action-ink);
  }

  .tel--button {
    padding-inline: var(--s-6);
    background: var(--c-action);
    color: var(--c-on-action);
    border-radius: var(--r-pill);
    box-shadow: var(--e-action);
    font-size: var(--fs-btn);
  }

  .tel--button:hover {
    background: var(--c-action-hover);
    box-shadow: var(--e-action-hover);
  }

  .tel--row {
    inline-size: 100%;
    justify-content: flex-start;
    gap: var(--s-3);
    padding: var(--s-3);
    border-radius: var(--r-3);
  }

  .tel--row:hover {
    background: var(--c-bg-tint);
  }

  .tel:focus-visible {
    outline: none;
    box-shadow: var(--ring);
    border-radius: var(--r-pill);
  }
</style>
