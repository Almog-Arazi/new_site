---
import { getCollection } from 'astro:content';
import site, { waHref } from '../../site.config';
import { displayPhone, telHrefFor } from '../../lib/format';
import Field from './Field.astro';
import Select from './Select.astro';
import Textarea from './Textarea.astro';
import FormSuccess from './FormSuccess.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

/* The short lead form — five fields, navy panel.
 *
 * Submitting composes the fields into a Hebrew message and opens WhatsApp
 * with it prefilled; see form.ts. Nothing is posted anywhere, so the form
 * carries no action and no hidden provider fields, and there is no honeypot
 * — with no inbox behind it there is nothing for a bot to poison.
 *
 * Without JavaScript there is no way to compose the message, so the noscript
 * block hands over the two channels that need no scripting at all.
 */

interface Props {
  heading?: string;
  intro?: string;
  /** 2 inside a page that has no other h2 nearby, 3 when nested. */
  headingLevel?: 2 | 3;
  /** false when the caller already supplies its own heading. */
  showHead?: boolean;
  /**
   * false drops the navy panel chrome (padding / background / radius) so the
   * form can sit inside a dark card that already provides it — the homepage
   * hero card, for instance. The field palette stays on-dark either way.
   */
  panel?: boolean;
  id?: string;
}

const {
  heading = 'טופס תיאום בדיקה',
  intro = 'חמישה שדות בלבד. נחזור אליכם לתיאום ולמתן הצעת מחיר.',
  headingLevel = 2,
  showHead = true,
  panel = true,
  id = 'lead-form',
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';

const phone = displayPhone(site.phoneE164);
const tel = telHrefFor(site.phoneE164);

const equipment = (await getCollection('equipment')).sort(
  (a, b) => a.data.order - b.data.order
);

const equipmentOptions = [
  ...equipment.map((entry) => ({ value: entry.data.id, label: entry.data.label })),
  { value: 'other', label: 'כמה סוגים / ציוד אחר' },
];
---

<div class:list={['lead-form', !panel && 'lead-form--bare']} id={id} data-cta-quiet>
  {
    showHead && (
      <div class="lead-form__head">
        <Heading class="lead-form__title">{heading}</Heading>
        {intro && <p class="lead-form__intro">{intro}</p>}
      </div>
    )
  }

  <form
    class="lead-form__form"
    name={site.formName}
    data-lead-form
    data-wa={site.whatsapp.replace(/\D/g, '')}
  >
    <Field
      class="lead-form__half"
      id="lead-name"
      name="name"
      label="שם מלא"
      autocomplete="name"
      required
      maxlength={80}
    />

    <Field
      class="lead-form__half"
      id="lead-company"
      name="company"
      label="שם החברה"
      autocomplete="organization"
      maxlength={80}
    />

    <Field
      class="lead-form__half"
      id="lead-phone"
      name="phone"
      label="טלפון"
      type="tel"
      inputmode="tel"
      dir="ltr"
      autocomplete="tel"
      hint="נחזור אליכם למספר הזה."
      required
      maxlength={20}
    />

    <Select
      class="lead-form__half"
      id="lead-equipment"
      name="equipment"
      label="סוג הציוד לבדיקה"
      placeholder="בחרו סוג ציוד"
      options={equipmentOptions}
      required
    />

    <Textarea
      id="lead-message"
      name="message"
      label="הודעה"
      rows={2}
      placeholder="כמה יחידות, מיקום האתר, מתי בוצעה הבדיקה האחרונה…"
    />

    <p class="lead-form__status" role="status" data-form-status></p>

    <div class="lead-form__actions">
      <Button
        href={tel}
        variant="on-dark"
        size="lg"
        track="phone_click"
        class="lead-form__call"
      >
        <Icon name="phone" size={20} />
        <span>התקשרו עכשיו</span>
      </Button>

      <Button type="submit" variant="primary" size="lg" class="lead-form__go">
        שליחת הפרטים
      </Button>
    </div>

    <p class="lead-form__alt">
      <a href={waHref} data-track="whatsapp_click" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} />
        <span>או שלחו הודעה בוואטסאפ</span>
      </a>
    </p>

    <p class="lead-form__consent">
      הפרטים ייפתחו כהודעה מוכנה לשליחה. אפשר גם פשוט להתקשר ·
      <a href="/privacy">מדיניות פרטיות</a>
    </p>

    <noscript>
      <p class="lead-form__consent">
        הטופס דורש JavaScript. אפשר <a href={waHref}>לפתוח וואטסאפ ישירות</a> או
        להתקשר ל<a href={tel}><bdi class="ltr num">{phone}</bdi></a>.
      </p>
    </noscript>
  </form>

  <FormSuccess />
</div>

<script>
  import '../../scripts/form';
</script>

<style>
  .lead-form {
    display: grid;
    gap: var(--s-4);
    padding: var(--panel-pad);
    background: var(--c-bg-dark);
    border: 2px solid var(--c-action);
    border-radius: var(--r-4);
    color: var(--c-on-dark);
    box-shadow: var(--e-action);
  }

  /* Dropped into a card that already carries the navy panel. */
  .lead-form--bare {
    padding: 0;
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .lead-form__head {
    display: grid;
    gap: var(--s-2);
  }

  .lead-form__title {
    font-family: var(--ff-head);
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    font-weight: var(--fw-black);
    color: var(--c-white);
  }

  .lead-form__intro {
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--c-on-dark-muted);
  }

  .lead-form__form {
    display: grid;
    gap: var(--s-4);
  }

  .lead-form__form[hidden] {
    display: none;
  }

  .lead-form__status:empty {
    display: none;
  }

  .lead-form__status {
    font-size: var(--fs-sm);
    color: var(--c-accent-dark);
  }

  /* ── the three actions ────────────────────────────────────────
     Phone and submit are peers; WhatsApp is a text link under them. This
     audience — maintenance managers, safety officers, procurement — picks up
     the phone, and the form's only action used to be a full-width orange
     "send on WhatsApp", which put the least likely channel first.
     Phone sits first in source order, so under RTL it takes the start edge.
     ──────────────────────────────────────────────────────────── */
  .lead-form__actions {
    display: grid;
    gap: var(--s-3);
  }

  @media (width >= 560px) {
    .lead-form__actions {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* WhatsApp demoted to a text link. Still one tap, no longer the default. */
  .lead-form__alt {
    display: flex;
    justify-content: center;
  }

  .lead-form__alt a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: var(--tap);
    font-size: var(--fs-sm);
    color: var(--c-on-dark);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .lead-form__alt a:hover {
    color: var(--c-accent-dark);
  }

  .lead-form__alt a:focus-visible {
    outline: none;
    box-shadow: var(--ring-on-dark);
    border-radius: var(--r-1);
  }

  .lead-form__consent {
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--c-on-dark-muted);
  }

  .lead-form__consent a {
    color: var(--c-on-dark);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .lead-form__consent a:hover {
    color: var(--c-accent-dark);
  }

  /* ── field presentation ───────────────────────────────────────
     Held here rather than in each of Field / Select / Textarea so the
     three do not triplicate it. Scoped under .lead-form, so nothing
     leaks to the rest of the site.
     ──────────────────────────────────────────────────────────── */

  /* The hero has to fit one screen. Pairing the four short fields halves the
     panel's height without touching the 52px control size — shrinking the
     targets would have been the easy way and the wrong one. */
  @media (width >= 900px) {
    .lead-form {
      padding: var(--s-6);
      gap: var(--s-3);
    }

    .lead-form__form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--s-3) var(--s-4);
    }

    .lead-form__form > :global(:not(.lead-form__half)) {
      grid-column: 1 / -1;
    }

    .lead-form__intro {
      display: none;
    }
  }

  /* `align-content: start` matters: the fields sit in a two-column grid, and
     a stretched row was making the equipment <select> grow to match the
     phone field's extra hint line. The boxes are now the same size whatever
     sits beside them. */
  .lead-form :global(.field) {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }

  .lead-form :global(.field__label) {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-family: var(--ff-head);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--c-white);
  }

  .lead-form :global(.field__req) {
    color: var(--c-accent-dark);
  }

  .lead-form :global(.field__opt) {
    font-family: var(--ff-body);
    font-size: var(--fs-xs);
    font-weight: var(--fw-light);
    color: var(--c-on-dark-muted);
  }

  /* Hints use the on-dark ramp, never --c-text-muted (3.12:1). */
  .lead-form :global(.field__hint) {
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--c-on-dark-muted);
  }

  .lead-form :global(.field__control) {
    inline-size: 100%;
    block-size: var(--tap-lg);
    min-block-size: var(--tap);
    padding-inline: var(--s-4);
    padding-block: var(--s-3);
    font-family: var(--ff-body);
    font-size: var(--fs-body);
    font-weight: var(--fw-reg);
    line-height: 1.4;
    color: var(--c-text-strong);
    background: var(--c-surface);
    border: 1.5px solid transparent;
    border-radius: var(--r-2);
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .lead-form :global(.field__control--area) {
    block-size: auto;
    min-block-size: 0;
    line-height: var(--lh-body);
    resize: vertical;
  }

  .lead-form :global(.field__control::placeholder) {
    color: var(--c-text-muted);
  }

  .lead-form :global(.field__control:hover) {
    border-color: var(--c-bg-tint-strong);
  }

  .lead-form :global(.field__control:focus-visible) {
    outline: none;
    border-color: var(--c-link);
    box-shadow: var(--ring-on-dark);
  }

  /* Invalid state is never colour-only: the control gains a red border,
     the label gains an error line with a "!" mark, and aria-invalid plus
     aria-describedby carry it to assistive tech. */
  .lead-form :global(.field__control[aria-invalid='true']) {
    border-color: var(--c-danger);
  }

  .lead-form :global(.field__error) {
    display: flex;
    align-items: flex-start;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    line-height: 1.5;
    /* Amber, not --c-danger: #b3261e on navy fails AA. The "!" mark and
       the message text carry the meaning either way. */
    color: var(--c-accent-dark);
  }

  .lead-form :global(.field__error[hidden]) {
    display: none;
  }

  .lead-form :global(.field__error-mark) {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: var(--s-5);
    block-size: var(--s-5);
    margin-block-start: 2px;
    font-family: var(--ff-head);
    font-size: var(--fs-xs);
    font-weight: var(--fw-black);
    color: var(--c-bg-dark);
    background: var(--c-accent-dark);
    border-radius: var(--r-pill);
  }
</style>
