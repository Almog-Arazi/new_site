---
/* Bot friction, not security.
   `netlify-honeypot="company-website"` on the form tells Netlify to bin any
   submission where this field is filled. The field name must not collide
   with the real `company` field.

   tabindex="-1" keeps it out of the tab order, which is also what lets
   aria-hidden sit on the wrapper without trapping a focusable element. */

interface Props {
  name?: string;
}

const { name = 'company-website' } = Astro.props;
---

<div class="hp" aria-hidden="true">
  <label for={name}>אתר החברה — נא להשאיר ריק</label>
  <input id={name} name={name} type="text" tabindex="-1" autocomplete="off" />
</div>

<style>
  .hp {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
