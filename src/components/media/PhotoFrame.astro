---
import PlaceholderArt from '../placeholders/PlaceholderArt.astro';
import type { PlaceholderVariant } from '../placeholders/index';
import manifest from '../../lib/image-manifest.json';

interface Props {
  variant: PlaceholderVariant;
  alt: string;
  /** Real photo path under /uploads once the photo day happens. */
  image?: string;
  note?: string;
  ratio?: 'hero' | 'card' | 'wide' | 'portrait' | 'auto';
  tone?: 'tint' | 'dark';
  eager?: boolean;
  /**
   * How wide this frame renders, so the browser can pick a variant before
   * layout. The default assumes the common case: full width on a phone,
   * about half the measure once the grid splits.
   */
  sizes?: string;
  class?: string;
}

const {
  variant,
  alt,
  image,
  note,
  ratio = 'card',
  tone = 'tint',
  eager = false,
  sizes = '(min-width: 901px) 50vw, 100vw',
  class: className,
} = Astro.props;

/* scripts/gen-images.mjs writes the manifest before every build. An image
   missing from it still renders — it just ships a single file, which is what
   happened to every photo on the site until this existed. */
type Entry = { width: number; height: number; widths: number[] };
const meta: Entry | undefined = image
  ? (manifest as Record<string, Entry>)[image]
  : undefined;

const srcset = meta?.widths.length
  ? [
      ...meta.widths.map((w) => `${image!.replace(/\.webp$/, `-${w}.webp`)} ${w}w`),
      `${image} ${meta.width}w`,
    ].join(', ')
  : undefined;
---

<figure class:list={['frame', `frame--${ratio}`, className]}>
  {
    image ? (
      <img
        src={image}
        srcset={srcset}
        sizes={srcset ? sizes : undefined}
        width={meta?.width}
        height={meta?.height}
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <>
        <PlaceholderArt variant={variant} note={note} tone={tone} />
        <figcaption class="vh">{alt}</figcaption>
      </>
    )
  }
</figure>

<style>
  /* The signature motif: asymmetric corners built from LOGICAL properties.
     The border-radius shorthand is physical and mirrors wrong under dir=rtl. */
  /* A grid or flex item defaults to `min-inline-size: auto`, which means it
     refuses to shrink below the intrinsic width of its contents. Dropped into
     a column narrower than that, this frame kept its own width and painted
     straight over the neighbouring column: measured 709px inside a 410px
     column at a 1024px viewport, and it pushed the whole page into horizontal
     scroll at 860px. The two lines below are the fix, and they belong here
     rather than at each of the nine call sites. */
  .frame {
    position: relative;
    margin: 0;
    min-inline-size: 0;
    max-inline-size: 100%;
    overflow: hidden;
    background: var(--c-bg-tint);
    border-start-start-radius: var(--r-frame-ss);
    border-start-end-radius: var(--r-frame-se);
    border-end-start-radius: var(--r-frame-es);
    border-end-end-radius: var(--r-frame-ee);
    box-shadow: inset 0 0 0 1px var(--c-border);
  }

  .frame--hero {
    aspect-ratio: var(--ar-hero);
  }

  .frame--card {
    aspect-ratio: var(--ar-card);
  }

  .frame--wide {
    aspect-ratio: var(--ar-wide);
  }

  .frame--portrait {
    aspect-ratio: var(--ar-portrait);
  }

  .frame img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
</style>
